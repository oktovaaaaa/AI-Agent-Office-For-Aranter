# Salin ke .env lalu isi. JANGAN commit file .env.

# Subdomain publik bridge (buat A record ke IP VPS di panel DNS mediacloud.id)
LIVE_DOMAIN=live.aranter.web.id

# Token rahasia live feed: SAMA dengan GitHub Secret LIVE_TOKEN di repo bot
# (buat dengan: python -c "import secrets;print(secrets.token_urlsafe(24))")
LIVE_TOKEN=

# Origin web yang boleh membaca bridge (kantor 3D lokal + domain publik)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://aranter.web.id,https://oktovaaaaa.github.io

# Chat AI di VPS (opsional). Kosong = chat mode ringkas (berita + kata kunci), live feed tetap jalan.
# Untuk AI: install Antigravity CLI di image/VPS dan isi perintahnya, lihat README.
ANALYST_CMD=
